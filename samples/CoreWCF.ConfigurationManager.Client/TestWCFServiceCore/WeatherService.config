<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<system.serviceModel>
		<bindings>
			<basicHttpBinding>
				<binding name="TextBinding" maxBufferSize="2147483647" maxReceivedMessageSize="2147483647">
					<readerQuotas maxStringContentLength="3000000" maxArrayLength="2147483647" />
					<security mode="None" />
				</binding>
			</basicHttpBinding>
			<customBinding>
				<binding name="BinaryBindingSSL">
					<binaryMessageEncoding>
						<readerQuotas maxStringContentLength="3000000" maxArrayLength="2147483647" />
					</binaryMessageEncoding>
					<httpsTransport maxReceivedMessageSize="2147483647" maxBufferSize="2147483647" />
				</binding>
			</customBinding>
		</bindings>
		<services>
			<service name="TestWCFServiceLib.Service.WeatherService">
				<endpoint address="/WeatherService.svc" binding="basicHttpBinding" bindingConfiguration="TextBinding" contract="TestWCFServiceLib.Service.IWeatherService" />
				<!--<endpoint address="/WeatherService.svc" binding="customBinding" bindingConfiguration="BinaryBindingSSL" contract="TestWCFServiceLib.Service.IWeatherService" />-->
			</service>
		</services>		
	</system.serviceModel>
</configuration>	