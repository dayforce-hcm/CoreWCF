<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <system.serviceModel>
        <bindings>
            <customBinding>
                <binding name="BinaryBindingSSL_IWeatherService">
                    <binaryMessageEncoding />
                    <httpsTransport />
                </binding>
            </customBinding>
        </bindings>
        <client>
            <endpoint address="https://localhost:7055/WeatherService.svc"
                binding="customBinding" bindingConfiguration="BinaryBindingSSL_IWeatherService"
                contract="IWeatherService" name="BinaryBindingSSL_IWeatherService" />
        </client>
    </system.serviceModel>
</configuration>