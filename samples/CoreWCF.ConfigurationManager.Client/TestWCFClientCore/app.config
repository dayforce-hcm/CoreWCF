<?xml version="1.0" encoding="utf-8"?>
<configuration>

	<system.serviceModel>
		<protocolMapping>
		  <add binding="basicHttpsBinding" scheme="https" />
	  </protocolMapping>
		<client>
			<endpoint address="http://localhost:5157/WeatherService.svc"
				binding="basicHttpBinding" bindingConfiguration="TextBinding"
				contract="TestWCFClientLib.WeatherService.IWeatherService"
				name="Net472_BasicHttpBinding_IWeatherService" />
			<endpoint address="https://localhost:7055/WeatherService.svc"
					binding="customBinding" bindingConfiguration="BinaryBindingSSL"
					contract="TestWCFClientLib.WeatherService.IWeatherService"
					name="NetCore_BinaryBindingSSL_IWeatherService" />
			<endpoint address="http://localhost:5151/WeatherService.svc"
					binding="basicHttpBinding" bindingConfiguration="TextBinding"
					contract="TestWCFClientLib.WeatherService.IWeatherService"
					name="NetCore_BasicHttpBinding_IWeatherService" />
		</client>
		<bindings>
			<basicHttpBinding>
				<binding name="TextBinding" maxBufferSize="2147483647" maxReceivedMessageSize="2147483647">
					<readerQuotas maxStringContentLength="3000000" maxArrayLength="2147483647" />
					<security mode="None" />
				</binding>
			</basicHttpBinding>
			<customBinding>
				<binding name="BinaryBindingSSL">
					<binaryMessageEncoding>
						<readerQuotas maxStringContentLength="3000000" maxArrayLength="2147483647" />
					</binaryMessageEncoding>
					<httpsTransport maxReceivedMessageSize="2147483647" maxBufferSize="2147483647" />
				</binding>
			</customBinding>
		</bindings>
	</system.serviceModel>
</configuration>
