<?xml version="1.0" encoding="utf-8" ?>
<Project ToolsVersion="14.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <_CoreWCFConfigClientFiles Include="$(MSBuildThisFileDirectory)\..\contentFiles\any\netstandard2.0\CoreWCF.ConfigurationManager.Client.config" />
  </ItemGroup>
  <Target Name="CopyCoreWCFConfigClientFiles" BeforeTargets="Build;Publish">
    <Copy SourceFiles="@(_CoreWCFConfigClientFiles)" DestinationFolder="$(OutputPath)" />
  </Target>
  <Target Name="CopyCoreWCFConfigClientFilesToPublishDir" BeforeTargets="ComputeFilesToPublish">
	<ItemGroup>
	  <ResolvedFileToPublish Include="@(_CoreWCFConfigClientFiles)">
		 <RelativePath>%(Filename)%(Extension)</RelativePath>
		<CopyToPublishDirectory>Always</CopyToPublishDirectory>
	  </ResolvedFileToPublish>
	</ItemGroup>
  </Target>
</Project>
